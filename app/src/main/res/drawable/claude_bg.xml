<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#FF1C0F09"
                android:startColor="#FF050506" />
            <corners android:radius="30dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="1"
                android:centerY="0"
                android:endColor="#00E8814F"
                android:gradientRadius="170dp"
                android:startColor="#77E8814F"
                android:type="radial" />
            <corners android:radius="30dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="2dp"
                android:color="#CCE8814F" />
            <corners android:radius="30dp" />
        </shape>
    </item>
</layer-list>
