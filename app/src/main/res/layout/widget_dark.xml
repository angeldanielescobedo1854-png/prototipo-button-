<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dark_bg">

    <ImageView
        android:id="@+id/w_mark"
        android:layout_width="124dp"
        android:layout_height="124dp"
        android:layout_gravity="top|end"
        android:layout_marginEnd="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_chatgpt" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/w_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/dark_tile"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chatgpt" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/w_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFFFFFFF"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/w_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFA9A9B3"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/w_box"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:visibility="invisible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_bar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/dark_bar"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="Escribe un mensaje…"
                android:textColor="#FFC9CAD6"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/w_clock"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/dark_btn"
                android:contentDescription="Programar"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_clock" />

            <ImageButton
                android:id="@+id/w_send"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/dark_btn"
                android:contentDescription="Enviar"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_send" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
